# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Security ---
# Active security scans (Nikto probes, DAST payloads) send attack-like traffic to the
# target. Disabled unless set to "true". Only scan hosts you own or are authorized to test.
ENABLE_ACTIVE_SCANS="false"
# Optional: when set, active scans require "Authorization: Bearer <SECSCAN_TOKEN>".
SECSCAN_TOKEN=""
# Required to change the Google Search Console verification code via POST /api/google-verification.
ADMIN_TOKEN=""
# Number of reverse-proxy hops in front of the app (e.g. 1 on Cloud Run) so rate limiting sees real client IPs.
TRUST_PROXY=""
# Local development only: allow auditing localhost / private-network hosts (disables SSRF protection).
ALLOW_PRIVATE_TARGETS="false"
# Gemini model used for AI summaries/fixes. Without GEMINI_API_KEY, responses are rule-based templates marked generatedBy: "rules".
GEMINI_MODEL="gemini-3.8-flash"
